# Copy to .env.local and fill in. Never commit the real file.
#
# A classic token with NO scopes is enough: Codetta only reads public repositories, and the
# token exists purely to raise GitHub's rate limit from 60 requests an hour to 5,000.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. Without it every request re-parses from scratch, which is slower and nothing else.
REDIS_URL=redis://localhost:6379
